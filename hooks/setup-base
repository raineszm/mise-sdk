#!/bin/sh
set -e

case "$(dpkg --print-architecture)" in
    # pinned mise 2026.9.1 (latest/stable)
    amd64) revision=211 ;;
    arm64) revision=212 ;;
    *)
        echo "mise SDK does not support this architecture" >&2
        exit 1
        ;;
esac

snap install mise --classic --revision="$revision"

cat <<'EOF' >/etc/profile.d/mise.sh
export PATH="/snap/bin:$PATH"
export MISE_DATA_DIR="/home/workshop/.local/share/mise"
eval "$(mise activate bash)"
EOF
